# --- личное: не уезжает в репозиторий и переживает обновление шаблона ---

# настройки под свой стрим (геометрия, шрифт, длина клипов)
движок/мои_настройки.py

# память проекта: предпочтения, статистика, журнал — у каждого своя
.claude/память/*
!.claude/память/ПАМЯТЬ.пример.md

# --- тяжёлое: не место в git ---

# кэш разбора: аудио, расшифровки, кадры, замеры раскладки
движок/work/

# исходники стримов (гигабайты)
СТРИМЫ/*
!СТРИМЫ/ЧТО ТУТ.txt

# готовые клипы стримера в формате 16:9
СЫРЫЕ КЛИПЫ/*
!СЫРЫЕ КЛИПЫ/ЧТО ТУТ.txt

# готовые клипы
Clips Ready/*
!Clips Ready/ЧТО ТУТ.txt

# --- служебное ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.cache/
.DS_Store
Thumbs.db
desktop.ini

# записи одной игры для шаблона /матч
СЫРЫЕ МАТЧИ/*
!СЫРЫЕ МАТЧИ/ЧТО ТУТ.txt


# личные медиа: заставки, концовки, звуки (у каждого свои)
движок/заставка/
